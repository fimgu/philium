{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Philium",
  "version": "0.1.0",
  "identifier": "dev.gunnarsson.philium",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Philium", "width": 1200, "height": 800, "minWidth": 800, "minHeight": 500, "dragDropEnabled": false }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/hal-desktop-server"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "12.0" }
  }
}
